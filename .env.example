# ── APP ──────────────────────────────────────────
APP_SECRET_KEY=your_random_32char_secret_here
APP_ENV=development
FRONTEND_URL=http://localhost:3000

# ── DATABASE (Supabase PostgreSQL — free tier) ───
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# ── REDIS (Upstash — free tier) ──────────────────
REDIS_URL=rediss://default:PASSWORD@HOST:PORT

# -- GOOGLE GEMINI AI (FREE tier: 1,500 req/day) -------------------------
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ── AWS S3 (free tier — 5GB/12 months) ───────────
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET_NAME=teamforge-uploads
AWS_S3_REGION=us-east-1

# ── SENDGRID EMAIL (free — 100/day) ──────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxx
EMAIL_FROM=noreply@teamforge.app

# ── GITHUB WEBHOOK ───────────────────────────────
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# ── JWT ──────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── VS CODE EXTENSION ────────────────────────────
VSCODE_EXTENSION_API_URL=http://localhost:8000
